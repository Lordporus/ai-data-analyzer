# AI Data Analyzer — Environment Configuration
# Copy this to .env and fill in your values

# ── Server ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# External-facing base URL — used for share link generation
# In production set this to your domain (e.g. https://buildwithporus.qzz.io)
APP_BASE_URL=http://localhost:8000

# Internal Docker network URL — used for container-to-container API calls
# In Docker Compose this should be http://analyzer-api:8000
# In local dev leave as http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# ── Upload limits ─────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ── LLM Configuration (optional — system works without this) ─────────────
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# ── Branding ──────────────────────────────────────────────────────────────
BRAND_NAME=AI Data Analyzer
BRAND_COLOR=#6C63FF
BRAND_LOGO_URL=

# ── Auth (required in production) ─────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING
API_KEY_ENTERPRISE=REPLACE_WITH_SECURE_RANDOM_STRING

# ── Billing / Razorpay (optional until subscriptions are enabled) ─────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_PORTAL_URL=

# ── Supabase Auth & Database ──────────────────────────────────────────────
# SUPABASE_URL and SUPABASE_ANON_KEY: used for user auth (sign-in, sign-up)
# SUPABASE_SERVICE_KEY: used for server-side DB operations (bypasses RLS)
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ── Task Queue (Upstash Redis TLS recommended) ─────────────────────────────
# Use rediss:// (double-s) for TLS — required for Upstash
REDIS_URL=rediss://default:password@your-upstash-host.upstash.io:6379
CELERY_BROKER_URL=rediss://default:password@your-upstash-host.upstash.io:6379

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# R2_ENDPOINT format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=your-r2-endpoint-here
R2_ACCESS_KEY=your-r2-access-key-here
R2_SECRET_KEY=your-r2-secret-key-here
R2_BUCKET=ai-analyzer-outputs
# R2_PUBLIC_URL: the public domain set up for your bucket (custom domain or r2.dev)
# Example: https://outputs.buildwithporus.qzz.io
R2_PUBLIC_URL=your-r2-public-url-here

# ── Usage tracking ────────────────────────────────────────────────────────
ENABLE_USAGE_TRACKING=false

# ── Scheduled Email Reports ───────────────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=you@yourdomain.com
SCHEDULER_ENABLED=false
