# AI Data Analyzer — Environment Configuration
# Copy this to .env and fill in your values

# Server
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
APP_BASE_URL=http://localhost:8000

# Upload limits
MAX_FILE_SIZE_MB=50

# LLM Configuration (optional — system works without this)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Branding
BRAND_NAME=AI Data Analyzer
BRAND_COLOR=#6C63FF
BRAND_LOGO_URL=

# Auth (optional locally, mandatory before production deployment)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING
API_KEY_ENTERPRISE=REPLACE_WITH_SECURE_RANDOM_STRING

# Billing / Stripe (optional until subscriptions are enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# Database & Storage & Task Queue
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
REDIS_URL=your-redis-url-here
CELERY_BROKER_URL=your-celery-broker-url-here
R2_ENDPOINT=your-r2-endpoint-here
R2_ACCESS_KEY=your-r2-access-key-here
R2_SECRET_KEY=your-r2-secret-key-here
R2_BUCKET=your-r2-bucket-here

# Usage tracking
ENABLE_USAGE_TRACKING=false

# Scheduled Email Reports
SENDGRID_API_KEY=your-sendgrid-api-key
SCHEDULER_ENABLED=true
